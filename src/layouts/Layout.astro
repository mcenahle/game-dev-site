---
import "../styles/global.scss";
import Info from "../components/Info.astro";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.8/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.8/js/bootstrap.bundle.min.js"
    ></script>
  </head>
  <ClientRouter />
  <body>
    <Info />
    <slot />
  </body>
  <footer>
    <hr />
    <p>
      © 2026 Mcenahle Game. All rights reserved. <b
        >本网站的源代码不跟随下方所列举的许可证。</b
      >
    </p>
    <p>
      <small>
        <img
          src="/images/gplv3-with-text-136x68.png"
          alt="gplv3 with text badge"
          width="60"
        /> 游戏源代码部分依照 <a
          href="https://www.gnu.org/licenses/gpl-3.0.html"
          target="_blank"
          ><u>GPL v3.0 许可证</u> <Icon name="mdi:open-in-new" />
        </a> 进行 <a href="/open-source/"
          ><u>开源</u> <Icon name="mdi:arrow-top-right" />
        </a>；其余游戏资源不跟随该开源许可证/遵循原许可证。</small
      >
    </p>
  </footer>
</html>
