---
import Navbar from "../../layouts/Navbar.astro";
import ReleaseLayout from "../../layouts/ReleaseLayout.astro";
import Notiosandmacos from "../../components/Not-ios-and-macos.astro";
import { Icon } from "astro-icon/components";

export const title = "v0.0.1 - 游戏开始开发";
export const date = "2026-08-08 12:05";
---

<Navbar />

<ReleaseLayout title={title} date={date}>
  <Notiosandmacos />
  <p>
    在 <a href="https://ddlc.moe" target="_blank"
      ><u>DDLC</u> <Icon name="mdi:open-in-new" /></a
    > 游戏中，不仅是见证了4位女生的“不只是一个文学社”，还看到了 Ren’Py 游戏引擎。那么我的独立游戏开发，现在开始。
  </p>
  <h3>一、样式</h3>
  <p>存档网格中，从3行2列改为2行2列。</p>
  <h3>二、杂项更改</h3>
  <p>更新游戏名称和版本信息。</p>
  <h3>三、完整更改日志</h3>
  <p>
    <a href="https://github.com/mcenahle/game/commits/v0.0.1" target="_blank"
      ><u>完整更改日志</u> <Icon name="mdi:open-in-new" />
    </a>
  </p>
</ReleaseLayout>
